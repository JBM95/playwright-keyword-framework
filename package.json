{
  "name": "playwright-keyword-framework",
  "version": "0.1.0",
  "private": true,
  "description": "Keyword-driven Playwright and TypeScript test automation framework foundation.",
  "scripts": {
    "test": "playwright test",
    "test:e2e": "playwright test tests/contact-list/ui",
    "test:headed": "playwright test --headed",
