{
  "name": "playwright-keyword-framework",
  "version": "0.1.0",
  "private": true,
  "description": "Keyword-driven Playwright and TypeScript test automation framework foundation.",
  "scripts": {
    "test": "playwright test",
    "test:contact-list:ui": "playwright test tests/contact-list/ui --project=contact-list-chromium",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "^20.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0"
  }
}
